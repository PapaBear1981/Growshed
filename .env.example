# Copy to .env (never commit .env) and replace both passwords.
# deploy/pi-setup.sh creates .env with random passwords for you on the Pi.

# Password the backend uses to talk to the MQTT broker (username: backend)
MQTT_BACKEND_PASSWORD=change-me-backend

# Password the ESP32 nodes (and the simulator) use (username: node).
# The same value goes into firmware/secrets.yaml when the nodes are flashed.
MQTT_NODE_PASSWORD=change-me-node

# Phone notifications through ntfy (https://ntfy.sh). Install the ntfy app on your phones
# and subscribe to the same topic. Anyone who knows the topic name can read your alerts,
# so make it long and random. Leave empty to turn notifications off.
GROWSHED_NTFY_URL=
# Only for a private ntfy server that needs an access token:
GROWSHED_NTFY_TOKEN=

# Optional dead man's switch: a healthchecks.io ping URL. The hub calls it every 5 minutes;
# if the Pi dies, healthchecks.io notices the silence and alerts you.
GROWSHED_HEALTHCHECK_URL=

# Port for the web GUI
GROWSHED_PORT=8000
