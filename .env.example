# Copy to .env (never commit .env) and replace both passwords.
# deploy/pi-setup.sh creates .env with random passwords for you on the Pi.

# Password the backend uses to talk to the MQTT broker (username: backend)
MQTT_BACKEND_PASSWORD=change-me-backend

# Password the ESP32 nodes (and the simulator) use (username: node).
# The same value goes into firmware/secrets.yaml when the nodes are flashed.
MQTT_NODE_PASSWORD=change-me-node

# Port for the web GUI
GROWSHED_PORT=8000
